{
  "name": "@koniverse/koni-docs",
  "version": "0.11.3",
  "type": "module",
  "description": "Koni-docs framework CLI + reusable lib for managing structured documentation",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/cli/index.mjs",
      "types": "./dist/cli/index.d.ts"
    },
    "./lib": {
      "import": "./dist/lib/index.mjs",
      "types": "./dist/lib/index.d.ts"
    },
    "./lib/markdown": {
      "import": "./dist/lib/markdown/index.mjs",
      "types": "./dist/lib/markdown/index.d.ts"
    },
    "./lib/schemas": {
      "import": "./dist/lib/schemas/index.mjs",
      "types": "./dist/lib/schemas/index.d.ts"
    }
  },
  "bin": {
    "koni-docs": "./dist/cli/index.mjs"
  },
  "files": [
    "dist",
    "src/viewer/astro.config.mjs",
    "src/viewer/postcss.config.mjs",
    "src/viewer/tsconfig.json",
    "src/viewer/env.d.ts",
    "src/viewer/components/**",
    "src/viewer/layouts/**",
    "src/viewer/lib/**",
    "src/viewer/pages/**",
    "src/viewer/public/**",
    "src/viewer/styles/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --import tsx --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/node": "^8.3.4",
    "@tailwindcss/postcss": "^4.3.0",
    "astro": "^4.16.19",
    "chokidar": "^3.6.0",
    "commander": "^11.1.0",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "shiki": "^1.29.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.10.5",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
