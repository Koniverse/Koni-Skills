{
  "name": "@koniverse/koni-docs",
  "version": "0.2.0-dev.0",
  "type": "module",
  "description": "Koni-docs framework CLI + reusable lib for managing structured documentation",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/cli/index.mjs",
      "types": "./dist/cli/index.d.ts"
    },
    "./lib": {
      "import": "./dist/lib/index.mjs",
      "types": "./dist/lib/index.d.ts"
    },
    "./lib/markdown": {
      "import": "./dist/lib/markdown/index.mjs",
      "types": "./dist/lib/markdown/index.d.ts"
    },
    "./lib/schemas": {
      "import": "./dist/lib/schemas/index.mjs",
      "types": "./dist/lib/schemas/index.d.ts"
    }
  },
  "bin": {
    "koni-docs": "./dist/cli/index.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --import tsx --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "gray-matter": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.10.5",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
