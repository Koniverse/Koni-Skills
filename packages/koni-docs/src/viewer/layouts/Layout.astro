---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import TreeNode from '../components/TreeNode.astro';
import type { TreeNode as TreeNodeT } from '../lib/corpus.ts';

interface Props {
  title: string;
  tree: TreeNodeT[];
}

const { title, tree } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="koni-docs Docs Preview" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Koni Docs</title>
    <script is:inline>
      // Theme hydration — applies before paint so we don't flash.
      const stored = localStorage.getItem('koni-docs-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = stored ?? (prefersDark ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
    <ViewTransitions />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <div class="flex min-h-screen">
      <!-- Mobile top bar -->
      <header
        class="fixed inset-x-0 top-0 z-40 flex h-14 items-center gap-3 border-b border-border bg-background/80 px-4 backdrop-blur md:hidden"
      >
        <button
          id="mobile-sidebar-toggle"
          aria-label="Toggle navigation"
          class="inline-flex size-9 items-center justify-center rounded-md text-foreground hover:bg-accent"
        >
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
          <span class="inline-block size-6 rounded bg-gradient-to-br from-primary to-info"></span>
          <span>Koni Docs</span>
        </a>
        <button
          id="theme-toggle-mobile"
          aria-label="Toggle theme"
          class="ml-auto inline-flex size-9 items-center justify-center rounded-md text-foreground hover:bg-accent"
        >
          <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
          <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
          </svg>
        </button>
      </header>

      <!-- Sidebar -->
      <aside
        id="app-sidebar"
        class="fixed inset-y-0 left-0 z-50 w-72 -translate-x-full border-r border-sidebar-border bg-sidebar text-sidebar-foreground transition-transform duration-200 ease-out md:sticky md:top-0 md:h-screen md:translate-x-0"
      >
        <div class="flex h-full flex-col">
          <!-- Sidebar header -->
          <div class="flex items-center justify-between gap-2 border-b border-sidebar-border px-4 py-4">
            <a href="/" class="flex items-center gap-2.5">
              <span class="inline-block size-7 rounded-md bg-gradient-to-br from-primary to-info shadow-inner"></span>
              <div class="flex flex-col leading-none">
                <span class="text-sm font-semibold tracking-tight">Koni Docs</span>
                <span class="text-[10px] text-sidebar-foreground/50">specs preview</span>
              </div>
            </a>
            <button
              id="theme-toggle-desktop"
              aria-label="Toggle theme"
              class="hidden size-8 items-center justify-center rounded-md text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground md:inline-flex"
            >
              <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
              </svg>
              <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
              </svg>
            </button>
          </div>

          <!-- Views -->
          <nav class="px-3 py-3">
            <p class="px-2 pb-1.5 text-[10px] font-semibold uppercase tracking-wider text-sidebar-foreground/40">
              Views
            </p>
            <a
              href="/"
              class:list={[
                'flex items-center gap-2 rounded-md px-2 py-1.5 text-sm transition',
                currentPath === '/'
                  ? 'bg-sidebar-primary/15 font-medium text-sidebar-foreground'
                  : 'text-sidebar-foreground/80 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground',
              ]}
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12 12 3l9 9" />
                <path d="M5 10v10h14V10" />
              </svg>
              <span>Dashboard</span>
            </a>
            <a
              href="/project"
              class:list={[
                'flex items-center gap-2 rounded-md px-2 py-1.5 text-sm transition',
                currentPath.startsWith('/project')
                  ? 'bg-sidebar-primary/15 font-medium text-sidebar-foreground'
                  : 'text-sidebar-foreground/80 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground',
              ]}
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="16" rx="2" />
                <path d="M3 10h18M8 4v16" />
              </svg>
              <span>Project Stories</span>
            </a>
          </nav>

          <!-- File tree -->
          <div class="flex-1 overflow-y-auto px-2 pb-6">
            <p class="px-3 pb-1.5 pt-2 text-[10px] font-semibold uppercase tracking-wider text-sidebar-foreground/40">
              docs/
            </p>
            <div class="flex flex-col gap-px">
              {tree.map((node) => (
                <TreeNode node={node} currentPath={currentPath} depth={0} />
              ))}
            </div>
          </div>
        </div>
      </aside>

      <!-- Mobile backdrop -->
      <div
        id="sidebar-overlay"
        class="fixed inset-0 z-40 hidden bg-background/60 backdrop-blur-sm md:hidden"
      ></div>

      <!-- Main viewport (full-width) -->
      <main class="flex min-h-screen w-full flex-1 flex-col pt-14 md:pt-0">
        <slot />
      </main>
    </div>

    <script>
      function setup() {
        const toggleBtn = document.getElementById('mobile-sidebar-toggle');
        const sidebar = document.getElementById('app-sidebar');
        const overlay = document.getElementById('sidebar-overlay');

        if (toggleBtn && sidebar && overlay) {
          const open = () => {
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
          };
          const close = () => {
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('hidden');
          };
          toggleBtn.addEventListener('click', () => {
            if (sidebar.classList.contains('-translate-x-full')) open();
            else close();
          });
          overlay.addEventListener('click', close);
        }

        const themeToggleD = document.getElementById('theme-toggle-desktop');
        const themeToggleM = document.getElementById('theme-toggle-mobile');
        const flip = () => {
          const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
          document.documentElement.classList.toggle('dark', next === 'dark');
          localStorage.setItem('koni-docs-theme', next);
          window.dispatchEvent(new CustomEvent('koni:theme', { detail: next }));
        };
        themeToggleD?.addEventListener('click', flip);
        themeToggleM?.addEventListener('click', flip);
      }
      document.addEventListener('astro:page-load', setup);
    </script>

    <!-- Live-reload (active only when koni-docs preview --watch is on) -->
    <script>
      (function () {
        if (typeof window === 'undefined') return;
        // The SSE endpoint either streams reload events (watch mode) or only
        // emits keepalive comments (non-watch) — connect optimistically. The
        // connection is idempotent thanks to a bus singleton + env-gated watcher.
        try {
          const es = new EventSource('/koni-docs-rt/reload');
          es.onmessage = () => { window.location.reload(); };
          es.onerror = () => { es.close(); };
          // Cleanup on Astro view-transition unload.
          document.addEventListener('astro:before-swap', () => es.close(), { once: true });
        } catch { /* EventSource unavailable — ignore */ }
      })();
    </script>

    <!-- Mermaid: client-side render of fenced diagrams -->
    <script is:inline type="module">
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

      function currentTheme() {
        return document.documentElement.classList.contains('dark') ? 'dark' : 'default';
      }

      async function renderMermaid() {
        const nodes = document.querySelectorAll('pre.mermaid');
        if (nodes.length === 0) return;
        // Restore raw source so re-renders work after theme flip.
        nodes.forEach((node) => {
          const src = node.getAttribute('data-mermaid-source');
          if (src) {
            node.removeAttribute('data-processed');
            node.innerHTML = '';
            node.textContent = src;
          }
        });
        mermaid.initialize({ startOnLoad: false, theme: currentTheme(), securityLevel: 'loose' });
        try {
          await mermaid.run({ querySelector: 'pre.mermaid' });
        } catch (err) {
          console.warn('[mermaid]', err);
        }
        attachMermaidExpand();
      }

      // Decorate each rendered `pre.mermaid` with a hover-revealed expand
      // affordance. Clicking the diagram (or the affordance) opens the
      // fullscreen modal defined below.
      function attachMermaidExpand() {
        document.querySelectorAll('pre.mermaid').forEach((node) => {
          if (node.dataset.expandBound === '1') return;
          node.dataset.expandBound = '1';
          node.classList.add('koni-mermaid-zoomable');
          // Cursor + title attribute hint at the affordance for keyboard users.
          node.setAttribute('tabindex', '0');
          node.setAttribute('role', 'button');
          node.setAttribute('aria-label', 'Open diagram in fullscreen');
          node.addEventListener('click', (ev) => {
            // If user is selecting text inside the SVG, don't intercept.
            const sel = window.getSelection?.();
            if (sel && sel.toString().length > 0) return;
            openMermaidModal(node);
          });
          node.addEventListener('keydown', (ev) => {
            if (ev.key === 'Enter' || ev.key === ' ') {
              ev.preventDefault();
              openMermaidModal(node);
            }
          });
        });
      }

      // ===== Mermaid fullscreen modal =====
      function openMermaidModal(sourceNode) {
        const svg = sourceNode.querySelector('svg');
        if (!svg) return;

        const modal = document.getElementById('koni-mermaid-modal');
        const stage = document.getElementById('koni-mermaid-stage');
        if (!modal || !stage) return;

        // Clone the SVG so the original stays in-flow and untouched.
        const clone = svg.cloneNode(true);
        // Drop any width/height attrs so the SVG can scale to the stage.
        clone.removeAttribute('width');
        clone.removeAttribute('height');
        clone.style.width = '100%';
        clone.style.height = '100%';
        clone.style.maxWidth = '100%';
        clone.style.maxHeight = '100%';

        stage.innerHTML = '';
        stage.appendChild(clone);

        modal.dataset.scale = '1';
        modal.dataset.tx = '0';
        modal.dataset.ty = '0';
        applyMermaidTransform();

        modal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }

      function closeMermaidModal() {
        const modal = document.getElementById('koni-mermaid-modal');
        const stage = document.getElementById('koni-mermaid-stage');
        if (!modal || !stage) return;
        modal.classList.remove('is-open');
        stage.innerHTML = '';
        document.body.style.overflow = '';
      }

      function applyMermaidTransform() {
        const modal = document.getElementById('koni-mermaid-modal');
        const stage = document.getElementById('koni-mermaid-stage');
        if (!modal || !stage) return;
        const s = parseFloat(modal.dataset.scale || '1') || 1;
        const tx = parseFloat(modal.dataset.tx || '0') || 0;
        const ty = parseFloat(modal.dataset.ty || '0') || 0;
        const scaleLabel = document.getElementById('koni-mermaid-zoom-label');
        if (scaleLabel) scaleLabel.textContent = `${Math.round(s * 100)}%`;
        stage.style.transform = `translate(${tx}px, ${ty}px) scale(${s})`;
      }

      function setupMermaidModalControls() {
        const modal = document.getElementById('koni-mermaid-modal');
        if (!modal || modal.dataset.bound === '1') return;
        modal.dataset.bound = '1';

        const stage = document.getElementById('koni-mermaid-stage');
        const closeBtn = document.getElementById('koni-mermaid-close');
        const zoomIn = document.getElementById('koni-mermaid-zoom-in');
        const zoomOut = document.getElementById('koni-mermaid-zoom-out');
        const zoomReset = document.getElementById('koni-mermaid-zoom-reset');

        closeBtn?.addEventListener('click', closeMermaidModal);

        // Click backdrop (not the stage) to close.
        modal.addEventListener('click', (ev) => {
          if (ev.target === modal) closeMermaidModal();
        });

        // Esc to close.
        document.addEventListener('keydown', (ev) => {
          if (ev.key === 'Escape' && modal.classList.contains('is-open')) {
            closeMermaidModal();
          }
        });

        function nudgeScale(delta) {
          const cur = parseFloat(modal.dataset.scale || '1') || 1;
          const next = Math.max(0.2, Math.min(6, cur + delta));
          modal.dataset.scale = String(next);
          applyMermaidTransform();
        }

        zoomIn?.addEventListener('click', () => nudgeScale(0.25));
        zoomOut?.addEventListener('click', () => nudgeScale(-0.25));
        zoomReset?.addEventListener('click', () => {
          modal.dataset.scale = '1';
          modal.dataset.tx = '0';
          modal.dataset.ty = '0';
          applyMermaidTransform();
        });

        // Wheel to zoom (centered on cursor for natural feel).
        stage?.addEventListener('wheel', (ev) => {
          if (!modal.classList.contains('is-open')) return;
          ev.preventDefault();
          const cur = parseFloat(modal.dataset.scale || '1') || 1;
          const factor = ev.deltaY < 0 ? 1.1 : 1 / 1.1;
          const next = Math.max(0.2, Math.min(6, cur * factor));
          modal.dataset.scale = String(next);
          applyMermaidTransform();
        }, { passive: false });

        // Drag-to-pan.
        let dragging = false;
        let startX = 0, startY = 0, baseTx = 0, baseTy = 0;
        stage?.addEventListener('pointerdown', (ev) => {
          dragging = true;
          startX = ev.clientX;
          startY = ev.clientY;
          baseTx = parseFloat(modal.dataset.tx || '0') || 0;
          baseTy = parseFloat(modal.dataset.ty || '0') || 0;
          stage.setPointerCapture(ev.pointerId);
          stage.style.cursor = 'grabbing';
        });
        stage?.addEventListener('pointermove', (ev) => {
          if (!dragging) return;
          modal.dataset.tx = String(baseTx + (ev.clientX - startX));
          modal.dataset.ty = String(baseTy + (ev.clientY - startY));
          applyMermaidTransform();
        });
        const endDrag = (ev) => {
          if (!dragging) return;
          dragging = false;
          try { stage.releasePointerCapture(ev.pointerId); } catch { /* ignore */ }
          stage.style.cursor = '';
        };
        stage?.addEventListener('pointerup', endDrag);
        stage?.addEventListener('pointercancel', endDrag);
      }

      document.addEventListener('astro:page-load', () => {
        renderMermaid();
        setupMermaidModalControls();
      });
      window.addEventListener('koni:theme', renderMermaid);
    </script>

    <!-- Mermaid fullscreen modal (hidden by default) -->
    <div id="koni-mermaid-modal" class="koni-mermaid-modal" role="dialog" aria-modal="true" aria-label="Diagram fullscreen view">
      <div class="koni-mermaid-toolbar">
        <button id="koni-mermaid-zoom-out" type="button" class="koni-mermaid-btn" title="Zoom out" aria-label="Zoom out">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
        </button>
        <span id="koni-mermaid-zoom-label" class="koni-mermaid-zoom-label">100%</span>
        <button id="koni-mermaid-zoom-in" type="button" class="koni-mermaid-btn" title="Zoom in" aria-label="Zoom in">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5v14"/></svg>
        </button>
        <button id="koni-mermaid-zoom-reset" type="button" class="koni-mermaid-btn" title="Reset zoom" aria-label="Reset zoom">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
        </button>
        <button id="koni-mermaid-close" type="button" class="koni-mermaid-btn koni-mermaid-close" title="Close (Esc)" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div id="koni-mermaid-stage" class="koni-mermaid-stage"></div>
      <div class="koni-mermaid-hint">Scroll to zoom · drag to pan · Esc to close</div>
    </div>
  </body>
</html>
